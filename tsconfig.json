{
  "compilerOptions": {
    "esModuleInterop": true,
    "skipLibCheck": true,
    "target": "es2022",
    "allowJs": true,
    "resolveJsonModule": true,
    "moduleDetection": "force",
    "isolatedModules": true,
    "verbatimModuleSyntax": true,
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "noImplicitOverride": true,
    "module": "NodeNext",
    "outDir": "dist",
    "sourceMap": true,
    "declaration": true,
    "lib": ["es2022", "esnext.disposable"]
  },
  "include": ["index.ts"],
  "exclude": [
    "node_modules",
    "dist",
    "coverage",
    "tests",
    "eslint.config.ts",
    "vitest.config.ts"
  ]
}
